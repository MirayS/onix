{
    "name": "mirays/onix",
    "description": "Streaming ONIX for Books 3.0 / 3.1 parser for PHP",
    "type": "library",
    "license": "MPL-2.0",
    "keywords": ["onix", "onix-3.1", "editeur", "books", "metadata", "xml", "streaming"],
    "authors": [
        {
            "name": "Vitali Kuzmich",
            "homepage": "https://github.com/MirayS",
            "email": "my@mirays.by",
            "role": "Maintainer"
        },
        {
            "name": "Chris Ribal",
            "email": "c.ribal@ribal-webentwicklung.de",
            "role": "Original author"
        },
        {
            "name": "Common Knowledge",
            "email": "hello@commonknowledge.coop",
            "role": "Contributor"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xmlreader": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-zip": "Read ONIX messages directly from zip archives",
        "ext-zlib": "Read gzipped ONIX messages"
    },
    "autoload": {
        "psr-4": {
            "MirayS\\Onix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MirayS\\Onix\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
